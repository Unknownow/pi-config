{
  "_comment": "Config for ~/.pi/agent/extensions/workflow. model is provider/model-id (see `pi --list-models`); thinking is off|minimal|low|medium|high|xhigh|max. Edit here or with `/flow model <role> <provider/id[:thinking]>`, then `/flow reload`. Synced by pi-config.",
  "roles": {
    "plan": {
      "model": "claude-bridge/claude-opus-5-5",
      "thinking": "medium"
    },
    "execute": {
      "model": "claude-bridge/claude-sonnet-5-5",
      "thinking": "medium"
    },
    "explore": {
      "model": "claude-bridge/claude-haiku-5-5",
      "thinking": "medium"
    },
    "advisor": {
      "model": "claude-bridge/claude-opus-5-5",
      "thinking": "medium"
    },
    "judge": {
      "model": "claude-bridge/claude-opus-5-5",
      "thinking": "medium"
    },
    "commit": {
      "model": "claude-bridge/claude-haiku-5-5",
      "thinking": "medium"
    },
    "arbiter": {
      "model": "claude-bridge/claude-opus-5-5",
      "thinking": "medium"
    },
    "escalate": {
      "model": "claude-bridge/claude-opus-5-5",
      "thinking": "high"
    },
    "test": {
      "model": "claude-bridge/claude-opus-5-5",
      "thinking": "medium"
    },
    "runner": {
      "model": "claude-bridge/claude-haiku-5-5",
      "thinking": "low"
    }
  },
  "startPhase": "plan",
  "contextGuardTokens": 140000,
  "autoJudge": "auto",
  "maxJudgeRounds": 5,
  "maxMinorRounds": 1,
  "finalizePlan": true,
  "returnToPlan": true,
  "planFlaw": "ask",
  "autopilot": true,
  "stagedPlans": "auto",
  "stageAdvance": "auto",
  "planRecap": "changes",
  "maxPlanRevisions": 2,
  "delivery": {
    "ask": true,
    "default": "merge",
    "splitCommits": true,
    "mergeMethod": "merge",
    "deleteBranch": true,
    "base": "",
    "branchPrefix": "flow/",
    "runner": "subagent"
  },
  "plans": {
    "sync": "remote",
    "localOnly": [],
    "keepDays": 14,
    "keepCount": 50
  },
  "protectedBranches": [
    "main",
    "master"
  ],
  "planPrompt": true,
  "approvePattern": "^((ok(ay)?|yes|yeah|yep|sure|alright|fine|great|good)[,.! ]+)?(then[, ]+)?(go|go ahead|go for it|do it|do that|do this|do them|do (it )?all( of (it|that|them))?|approved?|lgtm|ship it|execute( it| that| this| the plan)?|proceed|start|let'?s go|let'?s do it|run it|implement( it| that| this| the plan)?|build it|make it so)( for me)?( now)?( please)?[.! ]*$",
  "repeatedErrorThreshold": 3,
  "planBlockedTools": [
    "edit",
    "write"
  ],
  "planAllowedTools": [
    "^(read|grep|find|ls|bash|codemode|explore|advisor|judge)$",
    "(^|__)ctx_(search|execute|execute_file|batch_execute|fetch_and_index|index|stats|doctor)$",
    "^mcp__.+__(search|get|list|read|view|status|fetch|find|query|describe|show|lookup)(_\\w+)?$"
  ],
  "planReadOnlyBash": true,
  "planBashAllow": [
    "^unity (cmd )?(editor_status|console_status)\\b"
  ],
  "tokenWeights": {
    "input": 1,
    "output": 5,
    "cacheRead": 0.1,
    "cacheWrite": 1.25
  },
  "test": {
    "concurrency": 4,
    "maxTasks": 8,
    "runnerTimeoutMs": 2700000,
    "maxRounds": 3,
    "refails": 2,
    "delivery": "commit",
    "runnerTools": [
      "bash",
      "read",
      "grep",
      "find",
      "ls"
    ],
    "supervisorBashAllow": [
      "^adb( -[sdetHP] \\S+)* (devices|shell getprop)\\b",
      "^unity (cmd )?(status|editor_status|console_status)\\b"
    ],
    "runnerDeny": [
      "^adb( -[sdetHP] \\S+)* (reboot|reboot-bootloader|sideload|root|unroot|remount|disable-verity|enable-verity)\\b",
      "^adb\\b.*\\bshell\\b.*(\\brm\\s+-[a-z]*r|\\bwipe\\b|\\brecovery\\b|\\bfactory\\b|\\bformat\\b|\\breboot\\b)",
      "^fastboot\\b"
    ],
    "runnerPathFlags": [
      "--project-path",
      "-projectPath"
    ],
    "runnerPathEnv": [
      "UNITY_PROJECT_PATH"
    ]
  },
  "explore": {
    "maxQueries": 8,
    "concurrency": 8,
    "tools": [
      "read",
      "grep",
      "find",
      "ls"
    ]
  },
  "advisor": {
    "tools": [
      "read",
      "grep",
      "find",
      "ls"
    ],
    "maxTranscriptChars": 1500000
  },
  "arbiter": {
    "tools": [
      "read",
      "grep",
      "find",
      "ls"
    ]
  },
  "judge": {
    "tools": [
      "read",
      "grep",
      "find",
      "ls"
    ],
    "maxDiffChars": 400000
  },
  "knowledge": {
    "server": "knowledge",
    "roles": [
      "explore",
      "advisor",
      "judge",
      "arbiter"
    ],
    "tools": [
      "search",
      "get_entry",
      "get_rule_pack",
      "get_schema",
      "status"
    ],
    "env": {
      "KNOWLEDGE_OFFLINE": "1"
    },
    "judgeCheck": true
  },
  "subagent": {
    "extensions": [
      "~/.pi/agent/npm/node_modules/pi-claude-bridge/src/index.ts"
    ],
    "timeoutMs": 900000
  }
}
