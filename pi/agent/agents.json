{
  "_comment": "Config for ~/.pi/agent/extensions/agents (explore, advisor, test_run, judge, critic). model is provider/model-id; thinking is off|minimal|low|medium|high|xhigh|max. Edit here or with `/agents model <explore|advisor|runner|judge|critic> <provider/id[:thinking]>`. modelCost: cost multiplier per model (case-insensitive substring of the model id, longest key first; no match = 1.0). Synced by pi-config.",
  "roles": {
    "explore": {
      "model": "claude-bridge/claude-haiku-5-5",
      "thinking": "high"
    },
    "advisor": {
      "model": "claude-bridge/claude-opus-5-5",
      "thinking": "high"
    },
    "runner": {
      "model": "claude-bridge/claude-haiku-5-5",
      "thinking": "high"
    },
    "judge": {
      "model": "claude-bridge/claude-opus-5-5",
      "thinking": "high"
    },
    "critic": {
      "model": "claude-bridge/claude-opus-5-5",
      "thinking": "high"
    }
  },
  "explore": {
    "contextFiles": false,
    "maxQueries": 8,
    "concurrency": 8,
    "tools": [
      "read",
      "grep",
      "find",
      "ls"
    ]
  },
  "advisor": {
    "tools": [
      "read",
      "grep",
      "find",
      "ls"
    ],
    "maxTranscriptChars": 1500000
  },
  "judge": {
    "tools": [
      "read",
      "grep",
      "find",
      "ls"
    ],
    "maxDiffChars": 400000
  },
  "critic": {
    "tools": [
      "read",
      "grep",
      "find",
      "ls"
    ]
  },
  "modelCost": {
    "haiku": 0.2,
    "sonnet": 0.6,
    "opus": 1
  },
  "test": {
    "concurrency": 4,
    "maxTasks": 8,
    "runnerTimeoutMs": 2700000,
    "runnerTools": [
      "bash",
      "read",
      "grep",
      "find",
      "ls"
    ],
    "runnerDeny": [
      "^adb( -[sdetHP] \\S+)* (reboot|reboot-bootloader|sideload|root|unroot|remount|disable-verity|enable-verity)\\b",
      "^adb\\b.*\\bshell\\b.*(\\brm\\s+-[a-z]*r|\\bwipe\\b|\\brecovery\\b|\\bfactory\\b|\\bformat\\b|\\breboot\\b)",
      "^fastboot\\b"
    ],
    "runnerPathFlags": [
      "--project-path",
      "-projectPath"
    ],
    "runnerPathEnv": [
      "UNITY_PROJECT_PATH"
    ]
  },
  "knowledge": {
    "server": "knowledge",
    "roles": [
      "explore",
      "advisor",
      "judge",
      "critic"
    ],
    "tools": [
      "search",
      "get_entry",
      "get_rule_pack",
      "get_schema",
      "status"
    ],
    "env": {
      "KNOWLEDGE_OFFLINE": "1"
    },
    "judgeCheck": true
  },
  "subagent": {
    "extensions": [
      "~/.pi/agent/npm/node_modules/pi-claude-bridge/src/index.ts"
    ],
    "timeoutMs": 900000
  }
}
