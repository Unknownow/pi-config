{
  "theme": "dark",
  "defaultProvider": "claude-bridge",
  "defaultModel": "claude-opus-5-5",
  "defaultTools": [
    "+codemode"
  ],
  "images": {
    "blockImages": false
  },
  "showHardwareCursor": true,
  "quietStartup": false,
  "packages": [
    {
      "source": "npm:pi-claude-bridge",
      "extensions": [
        "+src/index.ts"
      ]
    }
  ],
  "tuiMode": "regular",
  "hideThinkingBlock": false,
  "extensions": [
    "__PI_CONFIG_REPO__/extension"
  ],
  "followUpMode": "one-at-a-time",
  "compaction": {
    "enabled": true,
    "reserveTokens": 40000,
    "keepRecentTokens": 10000
  }
}
